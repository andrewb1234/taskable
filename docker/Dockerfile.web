# syntax=docker/dockerfile:1.7

# ---- Stage 1: Build ----
FROM node:20-alpine AS builder

WORKDIR /app
COPY web/package.json web/package-lock.json* ./
RUN npm install --no-fund --no-audit

COPY web/ ./
# Point the Vite client at the docker-compose API service name.
ENV VITE_API_URL=/api/v1
RUN npm run build

# ---- Stage 2: Serve via nginx ----
FROM nginx:alpine

ARG VCS_REF=unknown
ARG VERSION=dev

LABEL org.opencontainers.image.title="Mouvadah Web" \
    org.opencontainers.image.description="Mouvadah human-agent control plane web application" \
    org.opencontainers.image.source="https://github.com/andrewb1234/mouvadah" \
    org.opencontainers.image.revision="${VCS_REF}" \
    org.opencontainers.image.version="${VERSION}" \
    org.opencontainers.image.licenses="AGPL-3.0-only"

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html
COPY LICENSE /usr/share/nginx/html/LICENSE.txt
COPY NOTICE /usr/share/nginx/html/NOTICE.txt
COPY THIRD_PARTY_NOTICES.md /usr/share/nginx/html/THIRD_PARTY_NOTICES.md

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD wget -q -O - http://127.0.0.1/ >/dev/null || exit 1
