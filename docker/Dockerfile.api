# syntax=docker/dockerfile:1.7
FROM python:3.12-slim

ARG VCS_REF=unknown
ARG VERSION=dev

LABEL org.opencontainers.image.title="Mouvadah API" \
    org.opencontainers.image.description="Mouvadah human-agent control plane API" \
    org.opencontainers.image.source="https://github.com/andrewb1234/taskable" \
    org.opencontainers.image.revision="${VCS_REF}" \
    org.opencontainers.image.version="${VERSION}" \
    org.opencontainers.image.licenses="AGPL-3.0-only"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Install deps first for layer cache friendliness.
COPY api/requirements.txt ./api/requirements.txt
RUN pip install --upgrade pip && pip install -r api/requirements.txt

# Copy the api package and pytest config.
COPY api ./api
COPY pytest.ini ./pytest.ini
COPY LICENSE /usr/share/licenses/mouvadah/LICENSE
COPY NOTICE /usr/share/licenses/mouvadah/NOTICE
COPY THIRD_PARTY_NOTICES.md /usr/share/licenses/mouvadah/THIRD_PARTY_NOTICES.md

# Persistent state mount point. docker-compose maps a named volume here.
RUN mkdir -p /app/data
VOLUME ["/app/data"]

ENV DATABASE_URL=sqlite:////app/data/taskable.db \
    MIGRATION_MODE=upgrade

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/healthz', timeout=3)"

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
