#!/bin/sh
set -eu

repository="andrewb1234/mouvadah"
config_root="${XDG_CONFIG_HOME:-$HOME/.config}/mouvadah"
data_root="${XDG_DATA_HOME:-$HOME/.local/share}/mouvadah"
install_root="$config_root/install"
compose_file="$install_root/compose.yml"
environment_file="$install_root/.env"

usage() {
  cat <<'EOF'
Usage:
  mouvadah install --email EMAIL --name NAME [--version VERSION]
  mouvadah start|stop|status|logs
  mouvadah uninstall

install downloads a checksummed release manifest, creates an owner-only local
configuration, starts or upgrades Mouvadah on http://localhost:3000, and
provisions the local owner. uninstall removes containers but deliberately
preserves data and credentials.
EOF
}

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    printf 'Required command not found: %s\n' "$1" >&2
    exit 1
  fi
}

compose() {
  docker compose --env-file "$environment_file" -f "$compose_file" "$@"
}

sha256_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{ print $1 }'
  else
    shasum -a 256 "$1" | awk '{ print $1 }'
  fi
}

verify_release_asset() {
  asset_path="$1"
  asset_name="$2"
  checksums_path="$3"
  expected_checksum="$(awk -v name="$asset_name" '$2 == name { print $1 }' "$checksums_path")"
  [ -n "$expected_checksum" ] || {
    printf 'Release checksums do not list %s.\n' "$asset_name" >&2
    exit 1
  }
  actual_checksum="$(sha256_file "$asset_path")"
  [ "$actual_checksum" = "$expected_checksum" ] || {
    printf 'Release checksum verification failed for %s.\n' "$asset_name" >&2
    exit 1
  }
}

set_installed_version() {
  target_version="$1"
  temporary_environment="$(mktemp "$install_root/.env.XXXXXX")"
  awk -v version="$target_version" '
    BEGIN { updated = 0 }
    /^MOUVADAH_VERSION=/ {
      if (!updated) {
        print "MOUVADAH_VERSION=" version
        updated = 1
      }
      next
    }
    { print }
    END {
      if (!updated) {
        print "MOUVADAH_VERSION=" version
      }
    }
  ' "$environment_file" >"$temporary_environment"
  chmod 600 "$temporary_environment"
  mv "$temporary_environment" "$environment_file"
}

install_mouvadah() {
  owner_email=""
  owner_name=""
  release_version="latest"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --email)
        [ "$#" -ge 2 ] || { printf '%s\n' "--email requires a value" >&2; exit 2; }
        owner_email="$2"
        shift 2
        ;;
      --name)
        [ "$#" -ge 2 ] || { printf '%s\n' "--name requires a value" >&2; exit 2; }
        owner_name="$2"
        shift 2
        ;;
      --version)
        [ "$#" -ge 2 ] || { printf '%s\n' "--version requires a value" >&2; exit 2; }
        release_version="$2"
        shift 2
        ;;
      *)
        printf 'Unknown install option: %s\n' "$1" >&2
        exit 2
        ;;
    esac
  done

  [ -n "$owner_email" ] || { printf '%s\n' "--email is required" >&2; exit 2; }
  [ -n "$owner_name" ] || { printf '%s\n' "--name is required" >&2; exit 2; }

  require_command curl
  require_command docker
  require_command openssl
  docker compose version >/dev/null

  umask 077
  mkdir -p "$install_root" "$data_root"
  chmod 700 "$config_root" "$install_root" "$data_root"

  if [ "$release_version" = "latest" ]; then
    release_base="https://github.com/$repository/releases/latest/download"
    image_version=""
  else
    case "$release_version" in
      v*) release_tag="$release_version"; image_version="${release_version#v}" ;;
      *) release_tag="v$release_version"; image_version="$release_version" ;;
    esac
    release_base="https://github.com/$repository/releases/download/$release_tag"
  fi

  temporary_manifest="$(mktemp "$install_root/.compose.XXXXXX")"
  temporary_checksums="$(mktemp "$install_root/.checksums.XXXXXX")"
  temporary_version="$(mktemp "$install_root/.version.XXXXXX")"
  trap 'rm -f "$temporary_manifest" "$temporary_checksums" "$temporary_version"' EXIT HUP INT TERM
  curl -fsSL "$release_base/compose.yml" -o "$temporary_manifest"
  curl -fsSL "$release_base/SHA256SUMS" -o "$temporary_checksums"
  curl -fsSL "$release_base/VERSION" -o "$temporary_version"

  verify_release_asset "$temporary_manifest" "compose.yml" "$temporary_checksums"
  verify_release_asset "$temporary_version" "VERSION" "$temporary_checksums"
  released_version="$(tr -d '\r\n' <"$temporary_version")"
  case "$released_version" in
    ""|*[!0-9A-Za-z.-]*)
      printf '%s\n' "Release VERSION is invalid." >&2
      exit 1
      ;;
  esac
  if [ -z "$image_version" ]; then
    image_version="$released_version"
  elif [ "$released_version" != "$image_version" ]; then
    printf 'Requested version %s but release reports %s.\n' \
      "$image_version" "$released_version" >&2
    exit 1
  fi

  if [ "$release_version" = "latest" ]; then
    release_version="v$released_version"
  else
    release_version="v$image_version"
  fi

  mv "$temporary_manifest" "$compose_file"
  rm -f "$temporary_checksums" "$temporary_version"
  trap - EXIT HUP INT TERM

  if [ ! -f "$environment_file" ]; then
    jwt_secret="$(openssl rand -hex 32)"
    {
      printf 'JWT_SECRET=%s\n' "$jwt_secret"
      printf 'MOUVADAH_CONFIG_DIR=%s\n' "$config_root"
      printf 'MOUVADAH_DATA_DIR=%s\n' "$data_root"
      printf 'MOUVADAH_VERSION=%s\n' "$image_version"
    } >"$environment_file"
    chmod 600 "$environment_file"
  elif ! grep -q "^MOUVADAH_VERSION=$image_version\$" "$environment_file"; then
    set_installed_version "$image_version"
  fi

  compose pull
  compose up -d --wait
  compose exec -T api python -m api.local_setup \
    --email "$owner_email" \
    --name "$owner_name" \
    --credentials-file /root/.config/mouvadah/credentials.env

  printf '%s\n' \
    "Mouvadah is running at http://localhost:3000" \
    "API: http://localhost:8000" \
    "Version: $release_version" \
    "Credentials: $config_root/credentials.env" \
    "Install mouvadah-mcp==$image_version from PyPI to connect an agent harness."
}

command_name="${1:-}"
[ "$#" -gt 0 ] && shift

case "$command_name" in
  install)
    install_mouvadah "$@"
    ;;
  start)
    compose up -d --wait
    ;;
  stop)
    compose down
    ;;
  status)
    compose ps
    ;;
  logs)
    compose logs -f
    ;;
  uninstall)
    compose down --remove-orphans
    printf '%s\n' \
      "Containers removed. Data remains at $data_root and configuration at $config_root."
    ;;
  help|-h|--help|"")
    usage
    ;;
  *)
    printf 'Unknown command: %s\n' "$command_name" >&2
    usage >&2
    exit 2
    ;;
esac
