{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "MouvadahRestoreDrillBackupRead",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::REPLACE_WITH_BACKUP_BUCKET/mouvadah/database/*"
    },
    {
      "Sid": "MouvadahRestoreDrillEvidenceWrite",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::REPLACE_WITH_BACKUP_BUCKET/mouvadah/database/drills/*"
    }
  ]
}
